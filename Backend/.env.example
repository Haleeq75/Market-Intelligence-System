# ─── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret-minimum-32-chars
APP_DEBUG=true
LOG_LEVEL=INFO

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://swarm:swarm@localhost:5432/swarm_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# ─── MCP Data Sources ──────────────────────────────────────────────────────────
NEWS_API_KEY=your-newsapi-key
ALPHA_VANTAGE_KEY=your-alpha-vantage-key
FINNHUB_API_KEY=your-finnhub-key
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-secret

# ─── Agent Config ──────────────────────────────────────────────────────────────
ARBITER_CONFIDENCE_THRESHOLD=0.35
ARBITER_DOMINANT_ADVANTAGE=0.20
MAX_NEWS_ARTICLES=15
MAX_ALTERNATIVE_SOURCES=10

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","https://your-production-domain.com"]
